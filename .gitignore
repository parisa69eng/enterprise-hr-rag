
# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE and operating system
.vscode/
.idea/
.DS_Store

# Qdrant local database
# Keep metadata and the prepared vector database for deployment.
# Ignore lock files and other local runtime files.
data/qdrant/*
!data/qdrant/meta.json
!data/qdrant/collection/
data/qdrant/collection/*
!data/qdrant/collection/hr_documents/
data/qdrant/collection/hr_documents/*
!data/qdrant/collection/hr_documents/storage.sqlite
data/qdrant/.lock

# Private data
data/private/

# Logs
*.log
